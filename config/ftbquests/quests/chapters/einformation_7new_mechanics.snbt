		{
			dependencies: ["6930C77988A640AF"]
			description: [
				"&7Las mecánicas de combate fueron modificadas por el mod &eBetter Combat&7."
				""
				"- &6&lArmas &r&7Cada arma tiene su propia animación de ataque y tiempo."
				""
				"- &6&lCombos &r&7Los ataques consecutivos realizarán combos."
				""
				"- &6&lMantener para atacar &r&7Puedes mantener presionado el botón de ataque para seguir atacando continuamente."			]
			icon: {
				Count: 1
				id: "minecraft:netherite_sword"
				tag: {
					Damage: 0
				}
			}
			id: "6B8B4323E13AB3E9"
			rewards: [{
				id: "475CDA6694C41230"
