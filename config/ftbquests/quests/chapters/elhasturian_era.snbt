	quest_links: [ ]
	quests: [
		{
			dependencies: ["04AF2E026BB918AE"]
			description: [
				"&cTermina todos los capítulos de Void's Invasion para desbloquear la historia de esta expansión."
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "eldritch_end:textures/mob_effect/hastur_presence.png"
				}
			}
			id: "73DA5990952CEA35"
			rewards: [{
				advancement: "prominent:level_50"
				auto: "enabled"
				criterion: ""
				id: "1D56AC4A22CDB24A"
				title: "&eDesbloquear Subida de Nivel 51-65"
				type: "advancement"
			}]
			shape: "diamond"
			size: 1.5d
			subtitle: "&8[Haz clic para leer las instrucciones]"
			tasks: [{
				advancement: "prominent:end_of_voids_invasion"
				criterion: ""
				id: "190537CB8ABEDC05"
				title: "&dTermina la Campaña de la Invasión del Vacío"
				type: "advancement"
			}]
			title: "&eLa Era Hasturiana"
			x: 0.0d
			y: -2.0d
		}
		{
			dependencies: ["73DA5990952CEA35"]
			description: [
				"&7&oEones atrás, S'kellak luchó contra los seres ancestrales, derrotando y apresando al ser primordial C'thulhu."
				""
				"&7&oMientras sus seguidores escapaban, las cadenas que aprisionaban a su hermanastro, un monstruo alto y encapuchado con tentáculos, fueron rotas. S'kellak no pudo detener su huida."
				""
				"&8(1/2)"
				"{@pagebreak}"
				"&7&oHasta ahora, tras el intento de dominación de las fuerzas restantes del vacío, todos los reinos se encuentran en su punto más débil."
				""
				"&e&oEl Rey en Amarillo ha regresado, y no se detendrá hasta que todos los reinos sucumban a su nuevo reinado."
				""
				"&8(2/2)"
			]
			hide_until_deps_complete: true
			hide_until_deps_visible: true
			icon: "ftbquests:book"
			id: "579138B8DB19724C"
			shape: "diamond"
			size: 1.25d
			subtitle: "&8[Haz clic para leer el Lore]"
			tasks: [{
				id: "3E72FE8109B34FDF"
				title: "Continuar"
				type: "checkmark"
			}]
			title: "&6&lCapítulo I: &e&lLa Sombra Bajo el Horizonte"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["579138B8DB19724C"]
			description: [
				"&8La misiva dice:"
				""
				"&7&o\"Champion, this is urgent."
				""
				"&7&oHe confirmado que es él, el ser primordial de todo lo impío, conocido como Hastur."
				""
				"&7&oPuedo sentir su presencia cercana; necesitamos todas nuestras defensas listas. Vaaz podría estar en peligro."
				""
				"&7&oVen aquí tan pronto como puedas. Te necesitamos, Flameborn."
				""
				"&7&oYou should also enchant your weapon with Smite, Hastur's followers are undead. You should be prepared for the worst.\""
			]
			hide_until_deps_complete: true
			hide_until_deps_visible: true
			icon: "soulsweapons:blood_vial_recipe_page"
			id: "440126C71C47DB94"
			shape: "octagon"
			subtitle: "&8[Haz clic para leer la Misiva]"
			tasks: [{
				icon: "prominent:flameborn_stone"
				id: "449870D454BEB253"
				title: "Usa la Piedra Flameborn y ve a Vaaz"
				type: "custom"
			}]
			title: "&eMisiva Urgente de S'kellak"
			x: 0.5d
			y: 1.5d
		}
		{
			dependencies: ["440126C71C47DB94"]
			description: [
				"&eNivel Requerido: 60"
				""
